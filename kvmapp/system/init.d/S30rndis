#!/bin/sh
#
# The stock script with three things changed: the interface is resolved rather
# than spelled, the gate admits an NCM profile as well as an RNDIS one, and the
# stop path matches udhcpd by its config path because BusyBox writes no pidfile.
# Everything else — the prefix derivation from the chip UID, the udhcpd config
# it generates — is the stock logic verbatim, because this file is copied over
# /etc/init.d at every update and a rewrite here is a rewrite of the gadget
# NIC's addressing on every device.
#
# It is shipped at all because the bridge runs it: releasing the gadget NIC from
# br0 leaves a standalone NIC, and this is what addresses one, so a copy that
# says usb0 puts the address and the DHCP server on a dead interface on any
# device whose NIC was renamed.

. /etc/profile

GADGET_CONFIG=/sys/kernel/config/usb_gadget/g0/configs/c.1

# The live gadget NIC, or nothing.
#
# It is not usb0. gether_setup allocates the netdev name from "usb%d", and
# unlinking a net function from configs/c.1 does not destroy it: only removing
# its functions/ directory does, and until then it keeps the name. So a device
# whose profile switched from RNDIS to NCM has an orphaned rndis.usb0 sitting on
# usb0 with no carrier while the live ncm.usb0 came up as usb1.
#
# The authority is the ifname attribute of whichever net function is linked into
# the config, which is readable on both ncm.* and rndis.*. Only one is ever
# linked, so the first hit is the answer.
gadget_nic() {
	for fn in "$GADGET_CONFIG"/ncm.* "$GADGET_CONFIG"/rndis.* "$GADGET_CONFIG"/eem.*
	do
		[ -r "$fn/ifname" ] || continue
		read -r name < "$fn/ifname"
		[ -n "$name" ] || continue
		echo "$name"
		return 0
	done
	return 0
}

gen_udhcpd_conf() {
	interface=${1}
	ipv4_prefix=${2}
	echo "start ${ipv4_prefix}.100"
	echo "end ${ipv4_prefix}.200"
	echo "interface ${interface}"
	echo "pidfile /var/run/udhcpd.${interface}.pid"
	echo "lease_file /var/lib/misc/udhcpd.${interface}.leases"
	echo "option subnet 255.255.255.0"
	echo "option lease 864000"
}

start() {
	# Either sentinel. mirrorSentinels writes /boot/usb.ncm and removes
	# /boot/usb.rndis0 for an NCM profile, so a gate that names only RNDIS
	# leaves an NCM gadget NIC with no address and no DHCP server at all -
	# the target gets a network card that can reach nothing, including the
	# NanoKVM itself. The addressing below is class-agnostic; it resolves
	# whichever NIC is linked, so the class the host speaks is irrelevant.
	if [ -e /boot/usb.rndis0 ] || [ -e /boot/usb.ncm ]
	then
		printf "start usb rndis: "
		if [ ! -e /boot/rndis.nodhcpd ]
		then
			interface=$(gadget_nic)
			if [ -z "$interface" ]
			then
				# No net function is linked, so there is no NIC to address.
				# That is a legitimate profile rather than a failure.
				echo "no gadget NIC"
				return 0
			fi
			if [ -e /boot/rndis.ipv4_prefix ]
			then
				ipv4_prefix=`cat /boot/rndis.ipv4_prefix`
			else
				id2=$(printf "%d" 0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 2))
				id3=$(printf "%d" 0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 4 | tail -c 2))
				if [ "$id2" = "$id3" ]
				then
					id2=$((id2 + 1))
				fi
				if [ "$id2" -ge 255 ]
				then
					id2=253
				fi
				if [ "$id3" -ge 255 ]
				then
					id3=254
				fi
				ipv4_prefix=10.$id2.$id3
			fi
			gen_udhcpd_conf "$interface" "${ipv4_prefix}" > "/etc/udhcpd.$interface.conf"
			ip addr add $ipv4_prefix.1/24 dev "$interface"
			udhcpd -S "/etc/udhcpd.$interface.conf"
		fi
		echo "ok"
	fi
}

# Every gadget NIC's pidfile, not one name. A rename leaves the previous boot's
# udhcpd running under the old interface's pidfile, and stopping only the live
# one would leave that server answering on the segment.
stop() {
	for pidfile in /var/run/udhcpd.usb*.pid
	do
		[ -e "$pidfile" ] || continue
		read -r pid < "$pidfile"
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		rm -f "$pidfile"
	done

	# BusyBox udhcpd honours the pidfile directive by ignoring it: it writes no
	# pidfile at all, so the loop above finds nothing and a second start leaves
	# two servers answering the same segment with different leases. Match the
	# process by the config path this script generates instead.
	for proc in /proc/[0-9]*
	do
		[ -r "$proc/cmdline" ] || continue
		case "$(tr '\0' ' ' < "$proc/cmdline")" in
			*udhcpd*/etc/udhcpd.usb*.conf*) kill "${proc#/proc/}" 2>/dev/null ;;
		esac
	done
}

restart() {
	stop
	start
}

if [ "${1}" = "start" ]
then
	start
elif [ "${1}" = "stop" ]
then
	stop
elif [ "${1}" = "restart" ]
then
	restart
fi
