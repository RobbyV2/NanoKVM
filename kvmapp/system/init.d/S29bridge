#!/bin/sh

BRIDGE=br0
PORT=eth0
# The gadget NIC's name is runtime state, so it is resolved rather than spelled.
# See gadget_nic below.
GADGET_CONFIG=/sys/kernel/config/usb_gadget/g0/configs/c.1
UPLINK_DIR=/etc/kvm/network
UPLINK="$UPLINK_DIR/l2-uplink"
STATE_DIR=/etc/kvm/presentation/network
PENDING="$STATE_DIR/pending.json"
RECOVERED="$STATE_DIR/recovered.json"
LAST_GOOD="$STATE_DIR/last-known-good.json"
# S30rndis runs after this script and, unless this flag is there, unconditionally
# puts the standalone 10.x.y.1/24 on the gadget NIC and starts a udhcpd on it.
# Bridged, that address sits on an enslaved port, and the DHCP server ends up on
# the bridged segment where it can answer the target ahead of the LAN's own with
# a lease whose config names no router and no DNS.
NODHCPD=/boot/rndis.nodhcpd

# Every port is released by reading them out of sysfs rather than by naming
# them, because the gadget half of the pair is whatever the last profile left
# behind and this may be running to clean up after a boot that named something
# else. eth0 is released again afterwards for the case where brif is unreadable:
# it is the one port whose release matters to the management address.
teardown() {
    for port in "/sys/class/net/$BRIDGE/brif/"*
    do
        [ -e "$port" ] || continue
        ip link set dev "${port##*/}" nomaster 2>/dev/null
    done
    ip link set dev "$PORT" nomaster 2>/dev/null
    ip link set dev "$BRIDGE" down 2>/dev/null
    ip link del "$BRIDGE" 2>/dev/null
}

# An armed marker means the apply that wrote it never reached its disarm, so the
# device comes back on stock eth0: no uplink file, no recorded intent to bridge.
#
# The marker is moved aside rather than deleted, because it is the only record
# of why the device is on eth0 and the server at S95 reports it as the last
# apply. A rename is the whole write: it cannot leave a partial file, and it
# clears the marker in the same operation, so a second boot cannot restore
# twice. The rm keeps that last part true on the filesystem where a rename
# somehow fails, since a marker left armed is the one outcome that strands the
# device in a restore loop.
restore_stock() {
    rm -f "$UPLINK" "$LAST_GOOD"
    mv "$PENDING" "$RECOVERED" 2>/dev/null || rm -f "$PENDING"
    sync
}

# The live gadget NIC, or nothing.
#
# It is not usb0. gether_setup allocates the netdev name from "usb%d", and
# unlinking a net function from configs/c.1 does not destroy it: only removing
# its functions/ directory does, and until then it keeps the name. So a device
# whose profile switched from RNDIS to NCM has an orphaned rndis.usb0 sitting on
# usb0 with no carrier while the live ncm.usb0 came up as usb1, and a script
# that spells usb0 bridges the dead one.
#
# The authority is the ifname attribute of whichever net function is linked into
# the config, which is readable on both ncm.* and rndis.*. Only one is ever
# linked, so the first hit is the answer.
gadget_nic() {
    for fn in "$GADGET_CONFIG"/ncm.* "$GADGET_CONFIG"/rndis.* "$GADGET_CONFIG"/eem.*
    do
        [ -r "$fn/ifname" ] || continue
        read -r name < "$fn/ifname"
        [ -n "$name" ] || continue
        echo "$name"
        return 0
    done
    return 0
}

# The gadget NIC exists only once the gadget is bound with a network function,
# and a bridge with no gadget port is a legitimate state, so its absence is not
# a failure. Nor is failing to enslave it: the worst case there is an attached
# host with no network, where returning non-zero costs the management address.
enslave_gadget() {
    gadget=$(gadget_nic)
    [ -n "$gadget" ] || return 0
    [ -e "/sys/class/net/$gadget" ] || return 0
    ip link set dev "$gadget" master "$BRIDGE" || return 0
    ip link set dev "$gadget" up || ip link set dev "$gadget" nomaster
    return 0
}

create() {
    mac=$(cat "/sys/class/net/$PORT/address" 2>/dev/null)
    [ -n "$mac" ] || return 1
    ip link add name "$BRIDGE" type bridge stp_state 0 forward_delay 0 || return 1
    ip link set dev "$BRIDGE" address "$mac" || return 1
    ip link set dev "$PORT" master "$BRIDGE" || return 1
    ip link set dev "$PORT" up || return 1
    ip link set dev "$BRIDGE" up || return 1
    enslave_gadget
    touch "$NODHCPD" 2>/dev/null
    mkdir -p "$UPLINK_DIR"
    echo "$BRIDGE" > "$UPLINK"
}

start() {
    # Cleared first and restored by create, so the flag tracks this boot rather
    # than an earlier one that bridged.
    rm -f "$NODHCPD"

    if [ -e "$PENDING" ]; then
        restore_stock
        return 0
    fi

    grep -q '"enabled"[[:space:]]*:[[:space:]]*true' "$LAST_GOOD" 2>/dev/null || return 0

    create && return 0

    # S30eth is next and reads the uplink file. Leaving br0 named there after a
    # failed creation would address a device that does not exist.
    teardown
    rm -f "$UPLINK"
    sync
    return 0
}

case "$1" in
    start) start ;;
    stop) teardown || true ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *) exit 1 ;;
esac
