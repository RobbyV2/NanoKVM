#!/bin/sh
# Stub iproute2 for the S94exit shell test. Records every invocation in
# $STUB_TRACE and keeps enough state under $STUB_STATE to answer the reads the
# script makes: rules by pref (with the kernel's EEXIST on a duplicate add and
# ENOENT on a delete that matches nothing), routes by table, tun devices under
# $SYS_NET, and one canned 10.x address per interface from addr.<ifname>.
echo "ip $*" >> "$STUB_TRACE"
S=$STUB_STATE
mkdir -p "$S"

if [ "$1" = -4 ]; then
	shift
	[ "$1" = -o ] && shift
	if [ "$1" = addr ] && [ "$2" = show ] && [ "$3" = dev ]; then
		if [ -r "$S/addr.$4" ]; then
			printf '5: %s    inet %s scope global %s\\       valid_lft forever preferred_lft forever\n' "$4" "$(cat "$S/addr.$4")" "$4"
		fi
		exit 0
	fi
	exit 1
fi

case "$1" in
tuntap)
	# tuntap add dev NAME mode tun
	[ -e "$SYS_NET/$4" ] && exit 2
	mkdir -p "$SYS_NET/$4"
	echo 0 > "$SYS_NET/$4/carrier"
	exit 0
	;;
addr)
	# addr replace A/32 dev NAME
	echo "$3" > "$S/tunaddr.$5"
	exit 0
	;;
link)
	case "$2" in
	set)
		# link set dev NAME mtu M up
		[ -e "$SYS_NET/$4" ] || exit 1
		echo "$6" > "$SYS_NET/$4/mtu"
		exit 0
		;;
	del)
		[ -e "$SYS_NET/$3" ] || exit 1
		rm -rf "$SYS_NET/$3"
		exit 0
		;;
	esac
	exit 1
	;;
route)
	case "$2" in
	replace)
		shift 2
		all="$*"
		table=${all##* table }
		spec=${all% table *}
		f="$S/route.$table"
		touch "$f"
		grep -vxF -- "$spec" "$f" > "$f.tmp"
		mv "$f.tmp" "$f"
		echo "$spec" >> "$f"
		exit 0
		;;
	show)
		# route show table T
		[ -r "$S/route.$4" ] && cat "$S/route.$4"
		exit 0
		;;
	flush)
		rm -f "$S/route.$4"
		exit 0
		;;
	esac
	exit 1
	;;
rule)
	f="$S/rules"
	touch "$f"
	case "$2" in
	add)
		# rule add pref P iif X lookup T | rule add pref P iif X unreachable
		pref=$4
		iif=$6
		if [ "$7" = lookup ]; then
			line="$pref:	from all iif $iif lookup $8"
		else
			line="$pref:	from all iif $iif $7"
		fi
		grep -qxF -- "$line" "$f" && { echo "RTNETLINK answers: File exists" >&2; exit 2; }
		echo "$line" >> "$f"
		exit 0
		;;
	del)
		# rule del pref P [iif X]
		pref=$4
		pattern="^$pref:"
		if [ "$5" = iif ]; then
			pattern="^$pref:	from all iif $6 "
		fi
		match=$(grep -m1 -- "$pattern" "$f") || { echo "RTNETLINK answers: No such file or directory" >&2; exit 2; }
		awk -v m="$match" 'BEGIN { done = 0 } { if (!done && $0 == m) { done = 1; next } print }' "$f" > "$f.tmp"
		mv "$f.tmp" "$f"
		exit 0
		;;
	show)
		# rule show pref P
		grep -- "^$4:" "$f"
		exit 0
		;;
	esac
	exit 1
	;;
esac
exit 1
